---
componentName: master-penguin

welcomeStyleCalamares: false
welcomeExpandingLogo: true

windowExpanding: normal
windowSize: 900px,560px
windowPlacement: center

sidebar: widget
navigation: widget

strings:
    productName:         "Master Penguin Linux"
    shortProductName:    "Master Penguin"
    version:             "1.0"
    shortVersion:        "1.0"
    versionedName:       "Master Penguin Linux 1.0"
    shortVersionedName:  "Master Penguin 1.0"
    bootloaderEntryName: "Master Penguin"
    productUrl:          "https://github.com/epinephrinerx/master-penguin-linux"
    supportUrl:          "https://github.com/epinephrinerx/master-penguin-linux/issues"
    knownIssuesUrl:      "https://github.com/epinephrinerx/master-penguin-linux/issues"
    releaseNotesUrl:     "https://github.com/epinephrinerx/master-penguin-linux/releases"

images:
    productLogo:         "logo.svg"
    productIcon:         "logo.svg"
    productWelcome:      "welcome.svg"

slideshow:               "show.qml"
slideshowAPI: 2

# The R-02 palette.
#
# The key names here are not a style choice. The previous version used
# sidebarBackground / sidebarText / sidebarTextSelect / sidebarBackgroundSelected,
# which are the names from Calamares 3.2 and from most of the documentation
# still in circulation. None of them exist in the 3.3.14 build on this disc:
#
#   $ grep -c sidebarBackground libcalamaresui.so.3.3.14   -> 0
#   $ strings libcalamaresui.so.3.3.14 | grep -E "^Sidebar"
#     SidebarBackground
#     SidebarText
#     SidebarTextCurrent
#     SidebarBackgroundCurrent
#
# Unrecognised keys are ignored rather than reported, so the whole block was
# silently dropped and the sidebar kept the default near-black -- step names
# in dark grey on dark grey, which is what could not be read.
#
# "Current" is this build's word for the step being shown. In 3.2 it was
# "Select".
style:
    SidebarBackground:        "#1668c4"
    SidebarText:              "#ffffff"
    SidebarBackgroundCurrent: "#f4f8fd"
    SidebarTextCurrent:       "#0d3c6e"
