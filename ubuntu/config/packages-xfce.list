# XFCE, assembled by hand rather than by pulling in the xubuntu-desktop
# metapackage, which drags in a great deal this distro does not want.

xorg
xserver-xorg
xfce4-session
xfwm4
xfdesktop4
xfce4-panel
xfce4-settings
xfce4-terminal
xfce4-appfinder
xfce4-notifyd
xfce4-power-manager
xfce4-screenshooter
xfce4-taskmanager
xfce4-whiskermenu-plugin
thunar
thunar-archive-plugin
thunar-volman
tumbler
mousepad
ristretto
xarchiver
galculator
lightdm
lightdm-gtk-greeter
lightdm-gtk-greeter-settings

# Keyboard layout indicator (R-11). A switching shortcut with nothing on
# screen to show which layout is live is how people type passwords in the
# wrong alphabet.
xfce4-xkb-plugin

# The dock, and the overview behind it (R-03).
plank
xfdashboard

# Look and feel. The macOS-like GTK, icon and cursor themes are fetched at
# build time -- they are not in the archive -- so these are the fallbacks that
# guarantee a fresh XFCE looks finished rather than broken.
adwaita-icon-theme
dmz-cursor-theme
fonts-dejavu-core
fonts-liberation
fonts-noto-core
fonts-noto-color-emoji
# Inter stands in for the macOS UI typeface. Apple's own fonts cannot be
# redistributed, so this is not a compromise made for taste.
fonts-inter
